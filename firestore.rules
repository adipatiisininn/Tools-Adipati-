rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /sessions/{sessionId} {
      // Signed-in users may read a session document to open its invitation link.
      // Production hardening: replace broad read with a dedicated invitation-token
      // design and validate viewer membership on the server.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true;
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || request.auth.uid in resource.data.allowedViewers);
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      match /history/{entryId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerUid == request.auth.uid;
        allow create: if signedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}